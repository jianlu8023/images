{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 62000,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "extensions": [
    "builtin:codemode"
  ],
  "defaultTools": [
    "+codemode",
    "-builtin:mcp"
  ],
  "cacheWarming": "idle",
  "showCacheMissNotices": true,
  "hideThinkingBlock": false,
  "cacheWarming": "off",
  "quietStartup": "header"
}
