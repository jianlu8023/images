# syntax=docker/dockerfile:1
# ==============================================================================
# curl HTTP/3 —— TLS 后端：OpenSSL 3.5.8（官方主库，内置 QUIC API）
#
# 统一版本（6 个 TLS 后端对比用，均取自 curl 8.22.0 官方 CI 同款组合）：
#   curl 8.22.0 / ngtcp2 v1.25.0 / nghttp3 v1.18.0 / 运行时 alpine:3.22
#   本变体额外：OpenSSL 3.5.8（官方 3.5.x 末版，自带 SSL_set_quic_tls_cbs）
#
# 说明：
# - OpenSSL >= 3.5 自带 QUIC TLS API（SSL_set_quic_tls_cbs），ngtcp2 的
#   OpenSSL 后端（libngtcp2_crypto_ossl）直接可用，无需 quictls 补丁分支
# - curl 8.19.0 起移除了 OpenSSL-QUIC 直连后端，HTTP/3 一律走 ngtcp2 + nghttp3
# - 所有上游源码在构建时从官方源 wget 下载并做 sha256 校验，
#   因此本目录**无需随附 src/ tarball**，任何人 clone 本仓库即可构建
# - 全功能：与发行版默认 curl 对齐，启用全部标准功能 + HTTP/3：
#   brotli / zstd / libssh(scp,sftp) / libidn2(IDN) / libpsl(PSL) /
#   OpenLDAP(ldap,ldaps) / GSS-API+Kerberos+SPNEGO(krb5) / NTLM / SMB(smbs)
#   构建阶段安装对应 *-dev 包并 --with-xxx 启用；运行阶段安装对应运行库
#
# 构建：docker buildx build -f Dockerfile-openssl -t curl:8.22.0-h3-openssl .
# 验证：docker run --rm curl:8.22.0-h3-openssl curl --http3-only -k https://...:4433/
# ==============================================================================

ARG ALPINE_VERSION=3.22

FROM alpine:${ALPINE_VERSION} AS build

ARG ALPINE_VERSION
ARG CURL_VERSION=8.22.0
ARG CURL_SHA256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7
ARG NGTCP2_VERSION=1.25.0
ARG NGHTTP3_VERSION=1.18.0
ARG OPENSSL_VERSION=3.5.8
ARG OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2

ENV PREFIX=/opt/h3 \
    OPENSSL_SRCDIR=openssl-${OPENSSL_VERSION} \
    NGTCP2_SRCDIR=ngtcp2-${NGTCP2_VERSION} \
    NGHTTP3_SRCDIR=nghttp3-${NGHTTP3_VERSION} \
    CURL_SRCDIR=curl-${CURL_VERSION} \
    LD_LIBRARY_PATH=/opt/h3/lib

# 构建工具（同一 apk 事务）+ 运行时库（openssl 运行时包在最终镜像重装）
RUN apk add --no-cache --virtual .build-deps \
        build-base autoconf automake libtool pkgconf bison gperf \
        cmake ninja perl make ca-certificates \
        zlib zlib-dev nghttp2 nghttp2-dev linux-headers \
        brotli-dev zstd-dev libssh-dev libidn2-dev libpsl-dev \
        openldap-dev krb5-dev

# ------------------------------------------------------------------------------
# 从官方源下载全部依赖源码（每次构建重新下载；sha256 校验失败即构建失败）
# ------------------------------------------------------------------------------
RUN cd / \
    && set -eux \
    && wget --tries=2 --timeout=30 -O curl-${CURL_VERSION}.tar.xz \
        "https://github.com/curl/curl/releases/download/curl-8_22_0/curl-${CURL_VERSION}.tar.xz" \
    && wget --tries=2 --timeout=30 -O nghttp3-${NGHTTP3_VERSION}.tar.gz \
        "https://github.com/ngtcp2/nghttp3/releases/download/v${NGHTTP3_VERSION}/nghttp3-${NGHTTP3_VERSION}.tar.gz" \
    && wget --tries=2 --timeout=30 -O ngtcp2-${NGTCP2_VERSION}.tar.gz \
        "https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.gz" \
    && wget --tries=2 --timeout=30 -O openssl-${OPENSSL_VERSION}.tar.gz \
        "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
    && echo "${CURL_SHA256}  /curl-${CURL_VERSION}.tar.xz" \
       | sha256sum -c - \
    && echo "2812e9c06583fa24c8dc46bdb5291310a69196352ceaca8fbe98106ff36ae7d8  /nghttp3-${NGHTTP3_VERSION}.tar.gz" \
       | sha256sum -c - \
    && echo "1c0843076528a87b65e9a9d455100941f4cb65d44f96c5da6ae56df146043955  /ngtcp2-${NGTCP2_VERSION}.tar.gz" \
       | sha256sum -c - \
    && echo "${OPENSSL_SHA256}  /openssl-${OPENSSL_VERSION}.tar.gz" \
       | sha256sum -c - \
    && tar -xJf /curl-${CURL_VERSION}.tar.xz -C /

# 1. OpenSSL 3.5.8（官方主库，内置 QUIC API）
RUN tar -xzf /openssl-${OPENSSL_VERSION}.tar.gz -C / \
    && cd ${OPENSSL_SRCDIR} \
    && ./Configure --prefix=${PREFIX} --libdir=lib no-makedepend no-apps no-docs no-tests \
    && make -j"$(nproc)" \
    && make install_sw \
    && cd / && rm -rf ${OPENSSL_SRCDIR} openssl-${OPENSSL_VERSION}.tar.gz

# 2. nghttp3（HTTP/3 + QPACK）
RUN tar -xzf /nghttp3-${NGHTTP3_VERSION}.tar.gz -C / \
    && cd ${NGHTTP3_SRCDIR} \
    && autoreconf -fi \
    && ./configure --prefix=${PREFIX} --enable-lib-only \
    && make -j"$(nproc)" \
    && make install \
    && cd / && rm -rf ${NGHTTP3_SRCDIR} nghttp3-${NGHTTP3_VERSION}.tar.gz

# 3. ngtcp2（QUIC 传输层 + OpenSSL 加密后端 libngtcp2_crypto_ossl）
#    官方 release tarball 自带已生成的 configure，直接使用
RUN tar -xzf /ngtcp2-${NGTCP2_VERSION}.tar.gz -C / \
    && cd ${NGTCP2_SRCDIR} \
    && PKG_CONFIG_PATH=${PREFIX}/lib/pkgconfig \
    LDFLAGS="-Wl,-rpath,${PREFIX}/lib" \
    ./configure --prefix=${PREFIX} --enable-lib-only --with-openssl \
    && make -j"$(nproc)" \
    && make install \
    && cd / && rm -rf ${NGTCP2_SRCDIR} ngtcp2-${NGTCP2_VERSION}.tar.gz

# 4. curl（HTTP/3 客户端，共享 libcurl）
RUN cd ${CURL_SRCDIR} \
    && PKG_CONFIG_PATH=${PREFIX}/lib/pkgconfig:/usr/lib/pkgconfig \
    CPPFLAGS="-I${PREFIX}/include" \
    LDFLAGS="-L${PREFIX}/lib -Wl,-rpath,${PREFIX}/lib" \
    ./configure --prefix=${PREFIX} \
        --with-openssl=${PREFIX} \
        --with-ngtcp2=${PREFIX} \
        --with-nghttp3=${PREFIX} \
        --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
        # --- 对齐默认 curl 的全部功能（均经 alpine 官方仓库 dev 包启用）---
        --with-brotli \
        --with-zstd \
        --with-libssh \
        --with-libidn2 \
        --with-libpsl \
        --with-gssapi \
        --enable-ntlm \
        --enable-smb \
    && make -j"$(nproc)" \
    && make install \
    && ${PREFIX}/bin/curl -V \
    && ${PREFIX}/bin/curl -V | grep -q 'HTTP3' \
    && ${PREFIX}/bin/curl -V | grep -q 'HTTP2' \
    && ${PREFIX}/bin/curl -V | grep -q 'brotli/' \
    && ${PREFIX}/bin/curl -V | grep -q 'zstd/' \
    && ${PREFIX}/bin/curl -V | grep -q 'libssh/' \
    && ${PREFIX}/bin/curl -V | grep -q 'libidn2/' \
    && ${PREFIX}/bin/curl -V | grep -q 'libpsl/' \
    && ${PREFIX}/bin/curl -V | grep -q 'GSS-API' \
    && ${PREFIX}/bin/curl -V | grep -q 'Kerberos' \
    && ${PREFIX}/bin/curl -V | grep -q 'SPNEGO' \
    && ${PREFIX}/bin/curl -V | grep -q 'NTLM' \
    && ${PREFIX}/bin/curl -V | grep -q 'IDN' \
    && ${PREFIX}/bin/curl -V | grep -q 'PSL' \
    && ${PREFIX}/bin/curl -V | grep -q 'ldaps' \
    && ${PREFIX}/bin/curl -V | grep -q 'smb' \
    && cd / && rm -rf ${CURL_SRCDIR} curl-${CURL_VERSION}.tar.xz

# ==============================================================================
# 运行阶段：最小依赖 + /opt/h3（自编译的 curl 与全部动态库）
# ==============================================================================
FROM alpine:${ALPINE_VERSION} AS runtime

ARG ALPINE_VERSION
RUN apk add --no-cache ca-certificates libstdc++ \
        openssl zlib nghttp2 \
        brotli-libs zstd-libs libssh libidn2 libpsl libldap krb5-libs

# 只拷运行所需（bin/lib），不含头文件与 man 页，保持镜像最小
COPY --from=build /opt/h3/bin /opt/h3/bin
COPY --from=build /opt/h3/lib /opt/h3/lib

ENV PATH=/opt/h3/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/h3/lib

RUN curl -V | grep -q 'HTTP3' \
    && curl -V | grep -q 'brotli/' \
    && curl -V | grep -q 'zstd/' \
    && curl -V | grep -q 'libssh/' \
    && curl -V | grep -q 'libidn2/' \
    && curl -V | grep -q 'libpsl/' \
    && curl -V | grep -q 'GSS-API' \
    && curl -V | grep -q 'NTLM' \
    && curl -V | grep -q 'smb' \
    && [ -z "$(ldd /opt/h3/bin/curl 2>&1 | grep -i 'not found' || true)" ]

CMD ["curl", "--version"]
